{
  "name": "@baz-scm/pgmq-ts",
  "version": "0.3.12",
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run lint && pnpm run format:fix",
    "lint": "eslint src --cache",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "test": "mocha --require ts-node/register test/**/*.spec.ts --exit"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "message-queue",
    "queues",
    "postgresql-extension",
    "pgmq"
  ],
  "author": "Baz Technologies",
  "license": "MIT",
  "description": "Typescript wrapper equivalent for pgmq-rs",
  "dependencies": {
    "pg": "^8.16.3"
  },
  "repository": {
    "url": "https://github.com/baz-scm/pgmq-ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/pg": "^8.15.6",
    "chai": "^5.3.3",
    "eslint": "^10.0.2",
    "mocha": "^11.7.5",
    "pgmq-js": "^1.3.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
